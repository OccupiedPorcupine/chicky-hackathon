# Public hostname, without https://
APP_DOMAIN=chicky-app.duckdns.org

# Image registry and release identifier.
# We will fill these in when configuring image publishing.
IMAGE_REGISTRY=ghcr.io/occupiedporcupine
RELEASE_TAG=

# PostgreSQL connection used by the backend.
# Production will use Supabase after access and migration review.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Shared authentication secret between backend and ML.
ML_SHARED_SECRET=

# Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_FROM=
MAIL_PASSWORD=

# Keep the assistant offline until its integration is configured.
ASSISTANT_PROVIDER=offline
OPENAI_API_KEY=

# Optional integrations
GOOGLE_CLIENT_ID=
# Set all three Telegram values to enable linking and authenticated webhooks.
# Use a separate bot per environment; one bot can have only one webhook URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=